# Copiar a .env. El .env nunca se commitea.
#   Linux/Mac:  cp .env.example .env
#   Windows:    copy .env.example .env

ENV=dev
LOG_LEVEL=INFO

# Fuera de Docker (uv run ...) la base está en el puerto 5433.
# Dentro de Docker Compose se pisa automáticamente con db:5432.
DATABASE_URL=postgresql+psycopg://onboarding:onboarding@localhost:5433/onboarding

# --- Modelo ---
# fake        -> respuestas fijas, sin red ni costo (default de tests y CI)
# openrouter  -> cualquier modelo (Claude, GPT, Llama, Qwen...) con una sola API key
# openai_compat -> Ollama u otro self-host con API compatible con OpenAI
LLM_PROVIDER=fake
# Con openrouter, uno gratis (terminan en :free). La interfaz /ui deja elegir otros.
LLM_MODEL=google/gemma-4-31b-it:free
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # default; no hace falta tocarla

# Modelo abierto local (perfil local-llm de docker compose)
OPENAI_COMPAT_BASE_URL=http://ollama:11434/v1
# Si Ollama corre en tu máquina (fuera de Docker), usá esta y arrancalo con
# OLLAMA_HOST=0.0.0.0 OLLAMA_CONTEXT_LENGTH=16384 (ver docs/setup.md, "Ollama local"):
# OPENAI_COMPAT_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_COMPAT_API_KEY=ollama

# Modelos que ofrece el selector de la interfaz (/ui), como lista JSON. Solo se
# muestran los que existen hoy. OpenRouter se completa hasta 6 con gratis que
# razonan; si la lista tiene más, van todos. OLLAMA_MODELS vacío: todos los
# instalados.
OPENROUTER_MODELS=["nvidia/nemotron-3-ultra-550b-a55b:free", "google/gemma-4-31b-it:free", "google/gemma-4-26b-a4b-it:free"]
OLLAMA_MODELS=["gemma3:4b"]

# --- Slack (Events API; cada dev usa su propia app de prueba, ver docs/setup.md) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Talleres (/ui, botón Test) ---
# En dev (ENV=dev) se entra sin clave. En prod, sin ADMIN_PASSWORD los talleres
# quedan desactivados; con ella, el botón Test la pide.
ADMIN_PASSWORD=

# --- Túnel con ngrok (opcional; alternativa a cloudflared con dominio fijo) ---
# Cada uno con su cuenta gratuita: https://dashboard.ngrok.com
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
